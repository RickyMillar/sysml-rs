diff --color -ruN pa/models/SE_Models/eVehicleLibrary.sysml pb/models/SE_Models/eVehicleLibrary.sysml
--- pa/models/SE_Models/eVehicleLibrary.sysml	1970-01-01 12:00:00.000000000 +1200
+++ pb/models/SE_Models/eVehicleLibrary.sysml	2026-08-13 03:15:55.450971007 +1200
@@ -0,0 +1,48 @@
+/**
+ * eVehicleLibrary - Stub library for HVAC and vehicle-related requirements.
+ *
+ * This stub provides placeholder type definitions to support HVACSystemRequirements.sysml
+ * and other vehicle system models. These types extend the ISQ (International System of
+ * Quantities) definitions for proper unit compatibility.
+ */
+standard library package eVehicleLibrary {
+    import ISQ::*;
+    import SI::*;
+    import ScalarValues::*;
+
+    /**
+     * Temperature type for thermal measurements.
+     * Extends ISQ ThermodynamicTemperatureValue for unit compatibility.
+     */
+    attribute def Temperature :> ISQ::ThermodynamicTemperatureValue;
+
+    /**
+     * Time duration type.
+     * Extends ISQ DurationValue for time measurements.
+     */
+    attribute def Time :> ISQ::DurationValue;
+
+    /**
+     * Percentage type for ratio measurements (0-100%).
+     * Extends ISQ DimensionOneValue as a dimensionless ratio.
+     */
+    attribute def Percentage :> ISQ::DimensionOneValue;
+
+    /**
+     * Distance type for spatial measurements.
+     * Extends ISQ LengthValue for distance/length measurements.
+     */
+    attribute def Distance :> ISQ::LengthValue;
+
+    /**
+     * Power type for energy rate measurements.
+     * Extends ISQ PowerValue for power consumption tracking.
+     */
+    attribute def Power :> ISQ::PowerValue;
+
+    /**
+     * Decibel type for sound level measurements.
+     * Extends ISQ DimensionOneValue as a logarithmic ratio.
+     */
+    attribute def Decibel :> ISQ::DimensionOneValue;
+}
