diff --git a/library.systems/StandardViewDefinitions.sysml b/library.systems/StandardViewDefinitions.sysml
index 94f975f..77bc435 100644
--- a/library.systems/StandardViewDefinitions.sysml
+++ b/library.systems/StandardViewDefinitions.sysml
@@ -120,4 +120,49 @@ standard library package StandardViewDefinitions {
              * branches and leaves of the tree, as in graphical user interface widgets.
              */
     }
+
+    view def UseCaseView specializes InterconnectionView {
+        doc /*
+             * View definition to present actors, use cases, and the include / extend
+             * relationships between them. The typical rendering is the UML use-case
+             * diagram shape: stick-figure actors at the boundary, use-case ovals in the
+             * subject system, and labelled associations between them.
+             */
+    }
+
+    // sysml-rs note: SysML v2 (Table 34 / clause 9.2.20) does NOT define a
+    // standard RequirementView. The GeneralView doc (above) models a
+    // "requirement view" as a GeneralView specialization selected by a
+    // filter. This def encodes exactly that — GeneralView + the documented
+    // requirement filter set — so `view def X :> Requirement` resolves to a
+    // filtered General view via the normal supertype walk.
+    view def RequirementView :> GeneralView {
+        doc /*
+             * Requirement view: a GeneralView filtered to requirement-related
+             * elements — requirement definitions/usages and the satisfy /
+             * derive / allocation relationships between them. Mirrors the
+             * "requirement view" filter listed in the GeneralView doc above.
+             */
+        // The spec requirement filter (per the GeneralView doc above). The
+        // inert relationship metaclasses (Specialization, FeatureTyping) listed
+        // in the doc are omitted: element-membership filtering ignores them
+        // either way, so including them would only add noise.
+        filter @SysML::RequirementDefinition or @SysML::RequirementUsage
+            or @SysML::SatisfyRequirementUsage
+            or @SysML::AllocationDefinition or @SysML::AllocationUsage;
+    }
+
+    // Bare-name view defs, the canonical spelling used in book/fixtures.
+    // Each :> its suffixed counterpart so the spec stdlib stays intact;
+    // `view def Foo :> Interconnection` resolves through to `InterconnectionView`.
+    view def General         :> GeneralView;
+    view def Interconnection :> InterconnectionView;
+    view def ActionFlow      :> ActionFlowView;
+    view def StateTransition :> StateTransitionView;
+    view def Sequence        :> SequenceView;
+    view def Geometry        :> GeometryView;
+    view def Grid            :> GridView;
+    view def Browser         :> BrowserView;
+    view def UseCase         :> UseCaseView;
+    view def Requirement     :> RequirementView;
 }
