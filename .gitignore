benchmarks/profiles/
scripts/__pycache__/

# Tree-sitter grammar iteration infrastructure
# Per-hash cache entries are ~50 MB each; the directory itself stays tracked
# for the README + baseline-metrics.json. Worktrees never leak into parent
# repo status (also enforced by .worktrees/.gitignore from inside).
.tree-sitter-cache/*/
.tree-sitter-cache/*.tmp
.tree-sitter-cache/.generate.lock
.worktrees/*
!.worktrees/.gitignore

# Local agent/run artifacts
.claude/workflows/
# Per-workspace Claude/MCP placeholders and generated model-index cache.
# Repository-owned agent instructions live under .claude/agents/.
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/settings.json
.claude/skills
/.mcp.json
/editors/.claude/
/editors/.mcp.json
/editors/simulation-app/.claude/
/editors/simulation-app/.mcp.json
/.migb-tmp/
.socraticodeignore
/tmp/
/.gate_*.txt
/.ig*_bucket.txt
/.p*_full.txt
/test_meta.sysml
