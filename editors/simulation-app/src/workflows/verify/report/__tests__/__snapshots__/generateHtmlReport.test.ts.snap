    </div>
    <div class="rpt-overall" data-overall="error">
      <span class="rpt-overall__badge" style="--badge-color: #d946ef; --badge-color-oklch: oklch(66% 0.27 320);" title="Error" aria-label="Overall verdict: Error">⚠</span>
      <div class="rpt-overall__counts">
        <span><strong>1</strong> pass</span>
        <span><strong>1</strong> fail</span>
        <span><strong>0</strong> inconclusive</span>
        <span><strong>2</strong> error</span>
      </div>
    </div>
  </header>
  
  <section class="rpt-section">
