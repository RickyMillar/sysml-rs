{
  "name": "tree-sitter-sysml",
  "version": "0.0.1",
  "description": "Sysml grammar for tree-sitter",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RickyMillar/sysml-rs.git",
    "directory": "crates/lang/sysml-parser-incremental/tree-sitter"
  },
  "license": "MIT OR Apache-2.0",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "sysml"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "prebuildify": "^6.0.0",
    "tree-sitter-cli": "^0.26.5"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip",
    "build": "tree-sitter generate",
    "build-wasm": "tree-sitter build --wasm",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse",
    "corpus": "./test_corpus.sh",
    "corpus:quick": "./test_corpus.sh --quick",
    "corpus:verbose": "./test_corpus.sh --quick --verbose",
    "corpus:lib": "./test_corpus.sh --pattern 'sysml.library/Systems Library'",
    "library": "./test_library.sh",
    "library:fail": "./test_library.sh --fail-only",
    "library:exec": "./test_library.sh --execution",
    "library:all": "./test_library.sh --all",
    "status": "./update_status.sh",
    "status:quick": "./update_status.sh --quick",
    "diagnose": "./diagnose.sh",
    "analyze": "./analyze_errors.sh",
    "generate": "./generate_from_xtext.sh",
    "generate:inline": "./generate_from_xtext.sh --inline"
  },
  "tree-sitter": [
    {
      "scope": "source.sysml",
      "injection-regex": "^sysml$"
    }
  ]
}
