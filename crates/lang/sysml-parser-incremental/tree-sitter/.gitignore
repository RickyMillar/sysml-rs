# Generated by tree-sitter CLI (regenerate with `npm run build`)
src/grammar.json
src/node-types.json
src/parser.c

# Generated token files. keywords/operators/enums.js are small (~5KB total)
# generated INPUTS that grammar.js `require()`s, so they must exist BEFORE
# `tree-sitter generate` can emit parser.c. They are committed so a fresh clone
# can generate the parser without first LFS-smudging the Xtext and running the
# generator. Regenerate on a spec drop with ./generate_from_xtext.sh and commit
# the result. Any other file dropped in generated/ stays ignored.
generated/*
!generated/keywords.js
!generated/operators.js
!generated/enums.js
